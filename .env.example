# NexusHR Environment Configuration (Example)
# Copy this file to .env and customize as needed

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///database/workforce.db
# For PostgreSQL / MySQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/workforce_db
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/workforce_db

# Optional AI LLM API Keys (Falls back to deterministic Vector RAG synthesizer if not provided)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
